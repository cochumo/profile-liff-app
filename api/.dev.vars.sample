# api/.dev.vars.sample
#
# このファイルをコピーして api/.dev.vars を作成し、値を設定してください。
#   cp api/.dev.vars.sample api/.dev.vars
#
# .dev.vars は gitignore 済みのため、実際の値を安全に記載できます。
# 本番環境へは wrangler secret put で登録してください。
#   $ pnpm run deploy:api  の前に:
#   $ cd api && pnpm exec wrangler secret put SUPABASE_URL
#   $ cd api && pnpm exec wrangler secret put SUPABASE_SERVICE_KEY

# Supabase > Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase > Settings > API > service_role キー（公開禁止）
SUPABASE_SERVICE_KEY=your-service-role-key
