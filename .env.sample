# =============================================================================
# .env.sample
#
# このファイルをコピーして .env を作成し、各値を設定してください。
#   cp .env.sample .env
#
# 【env ファイルの役割】
#   .env                 gitignore 済み / 開発者ごとに手動設定する値（このファイル）
#   .env.development     コミット済み   / pnpm run dev 時に自動で読み込まれる
#   .env.production      コミット済み   / pnpm run build 時に自動で読み込まれる
#   api/.dev.vars        gitignore 済み / Hono ローカル開発時のサーバー秘密情報
#
# 【VITE_ プレフィックスについて】
#   VITE_ 変数はビルド時にクライアント JS バンドルへ平文で埋め込まれます。
#   ブラウザの DevTools で誰でも確認できるため、秘密情報は絶対に入れないこと。
#   真に秘密にすべき値（API キー等）は Cloudflare Secrets に登録してください。
#     $ cd api && pnpm exec wrangler secret put SECRET_NAME
# =============================================================================

# -----------------------------------------------------------------------------
# LINE LIFF ID（ローカル開発用）
# LINE Developers Console > LIFFアプリ > LIFF ID をコピーして設定
# 公開情報のため .env への記載で問題ない（git には含まれない）
# -----------------------------------------------------------------------------
VITE_LIFF_ID=your_liff_id_here
